
<?xml version="1.0" encoding="UTF-8"?>
<sequence xmlns="http://ws.apache.org/ns/synapse"
          name="GenerateReprintSequence">

    <log level="custom">
        <property name="API" value="GenerateReprint"/>
        <property name="MESSAGE" value="Starting reprint generation"/>
    </log>

    <!-- Extract request parameter -->
    <property name="BTR_CODE"
              expression="json-eval($.btrCode)"
              scope="default"
              type="STRING"/>

    <!-- Validate batch report code -->
    <filter source="get-property('BTR_CODE')" regex="^[0-9]+$">

        <then>

            <!-- Execute Oracle stored procedure -->
            <dbreport>
                <connection>
                    <pool>
                        <driver>oracle.jdbc.OracleDriver</driver>
                        <url>jdbc:oracle:thin:@//192.168.0.28:1521/TQLIVE</url>
                        <user>TQ_LMS</user>
                        <password>YOUR_DB_PASSWORD</password>
                    </pool>
                </connection>

                <statement>
                    <sql>
                        BEGIN
                            TQ_LMS.LMS_WEB_PKG.GENERATEREPRINT(?);
                        END;
                    </sql>

                    <parameter expression="get-property('BTR_CODE')"
                               type="NUMERIC"/>
                </statement>
            </dbreport>

            <!-- Successful response -->
            <payloadFactory media-type="json">
                <format>
                    {
                        "success": true,
                        "message": "Reprint generated successfully",
                        "btrCode": "$1"
                    }
                </format>

                <args>
                    <arg evaluator="xml"
                         expression="get-property('BTR_CODE')"/>
                </args>
            </payloadFactory>

            <property name="HTTP_SC" value="200" scope="axis2"/>

            <respond/>

        </then>

        <else>

            <property name="HTTP_SC" value="400" scope="axis2"/>

            <payloadFactory media-type="json">
                <format>
                    {
                        "success": false,
                        "message": "Invalid or missing btrCode"
                    }
                </format>
                <args/>
            </payloadFactory>

            <respond/>

        </else>

    </filter>

</sequence>